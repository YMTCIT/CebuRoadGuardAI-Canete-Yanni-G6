# Make a COPY named .env, then replace the sample values locally.
# Never commit your real .env or share screenshots of its values.
DJANGO_SECRET_KEY=REPLACE_WITH_YOUR_OWN_LONG_RANDOM_SECRET
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional for cross-origin requests when deploying:
DJANGO_CSRF_TRUSTED_ORIGINS=
# Only enable behind a reverse proxy that YOU control and trust:
DJANGO_TRUSTED_PROXY_SSL=0

# Supabase Dashboard > Connect > Session pooler (port 5432).
# Copy the exact URL from Supabase; do not guess its host or username.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_SUPABASE_SESSION_POOLER_HOST:5432/postgres?sslmode=require
